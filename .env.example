# Copy this file to .env.local and fill in a free API key to use a REAL model.
# If you leave these blank, the app runs in MOCK mode (no key needed) — good
# enough to reproduce and fix every issue in the brief.
#
# Any OpenAI-compatible endpoint works. Free, no-credit-card options (2026):
#   Groq       VITE_LLM_BASE_URL=https://api.groq.com/openai/v1
#              VITE_LLM_MODEL=llama-3.3-70b-versatile
#   OpenRouter VITE_LLM_BASE_URL=https://openrouter.ai/api/v1
#              VITE_LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free
#   Cerebras   VITE_LLM_BASE_URL=https://api.cerebras.ai/v1
#              VITE_LLM_MODEL=llama-3.3-70b
#
# Pick a model that supports tool/function calling.

VITE_LLM_BASE_URL=
VITE_LLM_API_KEY=
VITE_LLM_MODEL=
